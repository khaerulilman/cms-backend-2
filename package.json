{
  "name": "portfolio-cms-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Portfolio CMS Backend API",
  "main": "server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate",
    "start": "node server.js",
    "prod": "cross-env NODE_ENV=production node server.js",
    "dev": "nodemon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . --output-file eslint-report.json --format json",
    "db:migrate": "prisma migrate dev",
    "bruno:merge": "node bruno/tools/merge-collection.js && node bruno/tools/convert-to-bru.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.39.0",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^8.5.1",
    "multer": "^2.0.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.3.0",
    "nodemon": "^3.1.11",
    "prisma": "^5.22.0"
  }
}
