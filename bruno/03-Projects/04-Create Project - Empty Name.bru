meta {
  name: Create Project - Empty Name
  type: http
  seq: 4
}

post {
  url: {{base_url}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: accessToken={{access_token}}
}

body:json {
  {
      "name": "",
      "description": "Project without name"
  }
}

tests {
  test('Status code is 400 or 422', function () {
      expect(res.getStatus()).to.be.oneOf([400, 422]);
  });
  
  test('Response contains error message', function () {
      const jsonData = res.getBody();
      expect(jsonData.message || jsonData.error).to.exist;
  });
}
