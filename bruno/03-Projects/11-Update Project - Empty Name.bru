meta {
  name: Update Project - Empty Name
  type: http
  seq: 11
}

put {
  url: {{base_url}}/v1/projects/{{project_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: accessToken={{access_token}}
}

body:json {
  {
      "name": ""
  }
}

tests {
  test('Status code is 400 or 422', function () {
      expect(res.getStatus()).to.be.oneOf([400, 422]);
  });
  
  test('Response contains validation error', function () {
      const jsonData = res.getBody();
      expect(jsonData.message || jsonData.error).to.exist;
  });
}
