meta {
  name: Create Project - Missing Name
  type: http
  seq: 5
}

post {
  url: {{base_url}}/v1/projects
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: accessToken={{access_token}}
}

body:json {
  {
      "description": "Project without name field"
  }
}

tests {
  test('Status code is 400 or 422', function () {
      expect(res.getStatus()).to.be.oneOf([400, 422]);
  });
  
  test('Response indicates missing field', function () {
      const jsonData = res.getBody();
      const responseText = JSON.stringify(jsonData).toLowerCase();
      expect(responseText.includes('required') || responseText.includes('name')).to.be.true;
  });
}
