meta {
  name: Get Project - Success
  type: http
  seq: 8
}

get {
  url: {{base_url}}/v1/projects/{{project_id}}
  body: none
  auth: none
}

headers {
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response has success property', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(true);
  });
  
  test('Response contains project data', function () {
      const jsonData = res.getBody();
      const project = jsonData.data;
      expect(project).to.have.property('id');
      expect(project).to.have.property('name');
      expect(project).to.have.property('userId');
  });
}
