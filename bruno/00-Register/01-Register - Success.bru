meta {
  name: Register - Success
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "name": "{{random_name}}",
      "email": "{{random_email}}",
      "password": "{{password}}"
  }
}

script:pre-request {
  // Generate unique email (timestamp + random)
  const timestamp = Date.now();
  const randomNum = Math.floor(Math.random() * 10000);
  const randomEmail = `user${timestamp}${randomNum}@example.com`;
  bru.setEnvVar('random_email', randomEmail);
  
  // Generate random name
  const names = ['John Doe', 'Jane Smith', 'Bob Johnson', 'Alice Williams'];
  const randomName = names[Math.floor(Math.random() * names.length)];
  bru.setEnvVar('random_name', randomName);
}

tests {
  test('Status code is 200 or 201', function () {
      expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
  
  test('Response time is less than 2000ms', function () {
      expect(res.getResponseTime()).to.be.below(2000);
  });
  
  test('Response is JSON', function () {
      expect(res.getBody()).to.be.an('object');
  });
  
  // Extract tokens from Set-Cookie headers
  if (res.getStatus() === 200 || res.getStatus() === 201) {
      const jsonData = res.getBody();
      const setCookie = res.getHeader('set-cookie');
      const cookieHeader = Array.isArray(setCookie) ? setCookie.join('; ') : (setCookie || '');
      
      let accessToken = null;
      let refreshToken = null;
      
      if (cookieHeader.includes('accessToken=')) {
          const match = cookieHeader.match(/accessToken=([^;\s]+)/);
          if (match && match[1]) {
              accessToken = match[1];
          }
      }
      
      if (cookieHeader.includes('refreshToken=')) {
          const match = cookieHeader.match(/refreshToken=([^;\s]+)/);
          if (match && match[1]) {
              refreshToken = match[1];
          }
      }
      
      if (accessToken) {
          bru.setEnvVar('access_token', accessToken);
      }
      
      if (refreshToken) {
          bru.setEnvVar('refresh_token', refreshToken);
      }
      
      if (jsonData && jsonData.data && jsonData.data.user) {
          bru.setEnvVar('user_id', jsonData.data.user.id);
      }
  }
}
