meta {
  name: Register - Invalid Email
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "name": "Test User",
      "email": "invalid-email",
      "password": "{{password}}"
  }
}

tests {
  test('Status code is 400 or 422', function () {
      expect(res.getStatus()).to.be.oneOf([400, 422]);
  });
  
  test('Response contains error message', function () {
      const jsonData = res.getBody();
      expect(jsonData.message || jsonData.error).to.not.be.undefined;
  });
}
