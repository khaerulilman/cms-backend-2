meta {
  name: Register - Weak Password
  type: http
  seq: 4
}

post {
  url: {{base_url}}/v1/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "name": "Test User",
      "email": "test@example.com",
      "password": "123"
  }
}

tests {
  test('Status code is 400 or 422', function () {
      expect(res.getStatus()).to.be.oneOf([400, 422]);
  });
  
  test('Error message mentions password', function () {
      const body = res.getBody();
      const responseText = (typeof body === 'string' ? body : JSON.stringify(body)).toLowerCase();
      expect(responseText).to.include('password');
  });
}
