meta {
  name: Trigger Error - Diagnostic
  type: http
  seq: 2
}

get {
  url: {{base_url}}/v1/test/error
  body: none
  auth: none
}

tests {
  test('Status code is 500', function () {
      expect(res.getStatus()).to.equal(500);
  });
  
  test('Response has error indication', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(false);
  });
}
