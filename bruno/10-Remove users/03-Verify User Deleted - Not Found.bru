meta {
  name: Verify User Deleted - Not Found
  type: http
  seq: 3
}

get {
  url: {{base_url}}/v1/auth/profile
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 404 Not Found or 401 Unauthorized', function () {
      expect(res.getStatus()).to.be.oneOf([401, 404]);
  });
  
  test('Response indicates user not found', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.be.false;
  });
}
