meta {
  name: Delete User Account - Success
  type: http
  seq: 1
}

delete {
  url: {{base_url}}/v1/auth/profile
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{access_token}}
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response is JSON', function () {
      expect(res.getBody()).to.be.an('object');
  });
  
  test('Response indicates user was deleted successfully', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.be.true;
      expect(jsonData.message).to.equal('User account deleted successfully');
  });
}
