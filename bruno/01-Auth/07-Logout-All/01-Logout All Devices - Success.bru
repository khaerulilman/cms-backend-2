meta {
  name: Logout All Devices - Success
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/auth/logout-all
  body: none
  auth: none
}

headers {
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response is JSON', function () {
      expect(res.getBody()).to.be.an('object');
  });
  
  test('Response indicates logout all success', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.be.true;
  });
}
