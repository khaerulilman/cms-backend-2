meta {
  name: Establish Session - Missing Token
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/auth/establish-session
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {}
}

tests {
  test('Status code is 400', function () {
      expect(res.getStatus()).to.equal(400);
  });
  
  test('Response indicates setup token is required', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.be.false;
      expect(jsonData.message).to.include('Setup token');
  });
}
