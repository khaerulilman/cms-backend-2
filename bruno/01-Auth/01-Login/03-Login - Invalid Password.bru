meta {
  name: Login - Invalid Password
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "email": "{{random_email}}",
      "password": "WrongPassword123!"
  }
}

tests {
  test('Status code is 401 or 400', function () {
      expect(res.getStatus()).to.be.oneOf([400, 401]);
  });
  
  test('Response indicates invalid credentials', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.be.false;
      const responseText = (jsonData.message || '').toLowerCase();
      expect(responseText.includes('invalid') || responseText.includes('credentials') || responseText.includes('password') || responseText.includes('email')).to.be.true;
  });
}
