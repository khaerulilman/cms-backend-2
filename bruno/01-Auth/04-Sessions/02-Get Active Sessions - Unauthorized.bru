meta {
  name: Get Active Sessions - Unauthorized
  type: http
  seq: 2
}

get {
  url: {{base_url}}/v1/auth/sessions
  body: none
  auth: none
}

headers {
  Authorization: Bearer invalid_expired_token_12345
}

tests {
  test('Status code is 401', function () {
      expect(res.getStatus()).to.equal(401);
  });
  
  test('Response indicates unauthorized', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.be.false;
  });
}
