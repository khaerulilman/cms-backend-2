meta {
  name: Upsert Cell - Missing Column ID
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/cms-cells/row/{{row_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: accessToken={{access_token}}
}

body:json {
  {
      "value": "Test cell content"
  }
}

tests {
  test('Status code is 400 or 422', function () {
      expect(res.getStatus()).to.be.oneOf([400, 422]);
  });
  
  test('Response has success property set to false', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(false);
  });
}
