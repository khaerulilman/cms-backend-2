meta {
  name: Get Column by ID - Not Found
  type: http
  seq: 8
}

get {
  url: {{base_url}}/v1/cms-columns/00000000-0000-0000-0000-000000000000
  body: none
  auth: none
}

headers {
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 400 or 404 or 500', function () {
      expect(res.getStatus()).to.be.oneOf([400, 404, 500]);
  });
  
  test('Response has success flag set to false', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(false);
  });
}
