meta {
  name: Get Column by ID - Success
  type: http
  seq: 7
}

get {
  url: {{base_url}}/v1/cms-columns/{{column_id}}
  body: none
  auth: none
}

headers {
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response is JSON', function () {
      expect(res.getBody()).to.be.an('object');
  });
  
  test('Response has success flag set to true', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(true);
  });
  
  test('Response contains column data', function () {
      const jsonData = res.getBody();
      expect(jsonData.data).to.have.property('id');
      expect(jsonData.data).to.have.property('name');
      expect(jsonData.data).to.have.property('tableId');
  });
}
