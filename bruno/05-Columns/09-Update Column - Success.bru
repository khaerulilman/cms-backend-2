meta {
  name: Update Column - Success
  type: http
  seq: 9
}

put {
  url: {{base_url}}/v1/cms-columns/{{column_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: accessToken={{access_token}}
}

body:json {
  {
      "name": "Updated Column Name"
  }
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response is JSON', function () {
      expect(res.getBody()).to.be.an('object');
  });
  
  test('Response has success flag set to true', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(true);
  });
  
  test('Response contains updated column data', function () {
      const jsonData = res.getBody();
      expect(jsonData.data.name).to.equal('Updated Column Name');
  });
}
