meta {
  name: Get Columns by Table - Success
  type: http
  seq: 6
}

get {
  url: {{base_url}}/v1/cms-columns/table/{{table_id}}
  body: none
  auth: none
}

headers {
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response is JSON', function () {
      expect(res.getBody()).to.be.an('object');
  });
  
  test('Response has success flag set to true', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(true);
  });
  
  test('Response contains columns array', function () {
      const jsonData = res.getBody();
      expect(Array.isArray(jsonData.data)).to.equal(true);
  });
}
