meta {
  name: Generate API Key - For Delete Test
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/apikey
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 201', function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  test('Response contains API Key data', function () {
      const jsonData = res.getBody();
      expect(jsonData.data).to.exist;
      expect(jsonData.data.id).to.exist;
  });
  
  if (res.getStatus() === 201) {
      const jsonData = res.getBody();
      bru.setEnvVar('api_key_for_delete', jsonData.data.apiKey);
      bru.setEnvVar('api_key_id_for_delete', jsonData.data.id);
  }
}
