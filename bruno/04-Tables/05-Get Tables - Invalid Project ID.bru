meta {
  name: Get Tables - Invalid Project ID
  type: http
  seq: 5
}

get {
  url: {{base_url}}/v1/tables/project/00000000-0000-0000-0000-000000000000
  body: none
  auth: none
}

headers {
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 400, 404, or 500', function () {
      expect(res.getStatus()).to.be.oneOf([400, 404, 500]);
  });
  
  test('Response indicates error', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(false);
  });
}
