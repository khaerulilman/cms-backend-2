meta {
  name: Update Table - Success
  type: http
  seq: 8
}

put {
  url: {{base_url}}/v1/tables/{{table_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: accessToken={{access_token}}
}

body:json {
  {
      "name": "Updated Table Name"
  }
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response has success flag set to true', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(true);
  });
  
  test('Table name is updated', function () {
      const jsonData = res.getBody();
      expect(jsonData.data.name).to.equal('Updated Table Name');
  });
}
