meta {
  name: Bulk Delete Rows - Empty Row IDs
  type: http
  seq: 9
}

delete {
  url: {{base_url}}/v1/cms-rows/bulk
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: accessToken={{access_token}}
}

body:json {
  {
      "rowIds": []
  }
}

tests {
  test('Status code is 400 or 422', function () {
      expect(res.getStatus()).to.be.oneOf([400, 422]);
  });
  
  test('Response indicates validation error', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(false);
  });
}
