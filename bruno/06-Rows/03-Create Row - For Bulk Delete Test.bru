meta {
  name: Create Row - For Bulk Delete Test
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/cms-rows
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Cookie: accessToken={{access_token}}
}

body:json {
  {
      "tableId": "{{table_id}}"
  }
}

tests {
  test('Status code is 201', function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  if (res.getStatus() === 201) {
      const jsonData = res.getBody();
      bru.setEnvVar('row_id_for_bulk_delete', jsonData.data.id);
  }
}
