meta {
  name: Update Row - Success
  type: http
  seq: 7
}

put {
  url: {{base_url}}/v1/cms-rows/{{row_id}}
  body: json
  auth: none
}

headers {
  Cookie: accessToken={{access_token}}
}

body:json {
  {}
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response has success property set to true', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(true);
  });
}
