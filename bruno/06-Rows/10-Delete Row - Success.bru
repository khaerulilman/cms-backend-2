meta {
  name: Delete Row - Success
  type: http
  seq: 10
}

delete {
  url: {{base_url}}/v1/cms-rows/{{row_id_for_delete}}
  body: none
  auth: none
}

headers {
  Cookie: accessToken={{access_token}}
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response has success property set to true', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(true);
  });
}
