meta {
  name: Get Public Table with API Key - Success
  type: http
  seq: 1
}

get {
  url: {{base_url}}/v1/project/{{project_id}}/table/{{table_id}}
  body: none
  auth: none
}

headers {
  x-api-key: {{api_key}}
}

tests {
  test('Status code is 200', function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  test('Response is JSON', function () {
      expect(res.getBody()).to.be.an('object');
  });
  
  test('Response contains table details', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(true);
      expect(jsonData.data).to.have.property('id');
  });
}
