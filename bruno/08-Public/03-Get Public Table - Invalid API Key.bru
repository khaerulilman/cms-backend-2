meta {
  name: Get Public Table - Invalid API Key
  type: http
  seq: 3
}

get {
  url: {{base_url}}/v1/project/{{project_id}}/table/{{table_id}}
  body: none
  auth: none
}

headers {
  x-api-key: invalid-api-key-value
}

tests {
  test('Status code is 401 or 403', function () {
      expect(res.getStatus()).to.be.oneOf([401, 403]);
  });
  
  test('Response indicates unauthorized', function () {
      const jsonData = res.getBody();
      expect(jsonData.success).to.equal(false);
  });
}
