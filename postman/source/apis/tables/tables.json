[
  {
    "name": "Create Table - Success",
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "exec": [
            "if (!pm.environment.get('access_token')) {",
            "    throw new Error('access_token is not set. Please run Auth folder first.');",
            "}"
          ],
          "type": "text/javascript",
          "packages": {},
          "requests": {}
        }
      },
      {
        "listen": "test",
        "script": {
          "exec": [
            "// NOTE: Before running this test, make sure to:",
            "// 1. Run 'Register - Success' to create a user",
            "// 2. Run 'Login - Success' to get access_token",
            "// 3. Run 'Create Project - Success' to get a valid project_id",
            "",
            "pm.test('Status code is 201', function () {",
            "    pm.expect(pm.response.code).to.equal(201);",
            "});",
            "",
            "pm.test('Response is JSON', function () {",
            "    pm.response.to.be.json;",
            "});",
            "",
            "pm.test('Response has success flag set to true', function () {",
            "    const jsonData = pm.response.json();",
            "    pm.expect(jsonData.success).to.equal(true);",
            "});",
            "",
            "pm.test('Response contains table data', function () {",
            "    const jsonData = pm.response.json();",
            "    pm.expect(jsonData.data).to.exist;",
            "    pm.expect(jsonData.data.id).to.exist;",
            "    pm.expect(jsonData.data.name).to.equal('Test Table');",
            "    pm.expect(jsonData.data.projectId).to.exist;",
            "});",
            "",
            "// Save first table ID for delete tests",
            "if (pm.response.code === 201) {",
            "    const firstTableId = pm.response.json().data.id;",
            "    pm.environment.set('table_id_for_delete', firstTableId);",
            "    ",
            "    // Create second table for column and other tests",
            "    pm.sendRequest({",
            "        url: pm.environment.get('base_url') + '/v1/tables',",
            "        method: 'POST',",
            "        header: {",
            "            'Content-Type': 'application/json',",
            "            'Cookie': 'accessToken=' + pm.environment.get('access_token')",
            "        },",
            "        body: {",
            "            mode: 'raw',",
            "            raw: JSON.stringify({",
            "                projectId: pm.environment.get('project_id'),",
            "                name: 'Persistent Table',",
            "                isSubTable: false",
            "            })",
            "        }",
            "    }, function (err, response) {",
            "        if (!err && response.code === 201) {",
            "            const secondTableId = response.json().data.id;",
            "            pm.environment.set('table_id', secondTableId);",
            "            console.log('✅ Created 2 tables:');",
            "            console.log('   - table_id_for_delete:', firstTableId);",
            "            console.log('   - table_id (persistent):', secondTableId);",
            "        }",
            "    });",
            "}"
          ],
          "type": "text/javascript",
          "packages": {},
          "requests": {}
        }
      }
    ],
    "request": {
      "method": "POST",
      "header": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cookie",
          "value": "accessToken={{access_token}}"
        }
      ],
      "body": {
        "mode": "raw",
        "raw": "{\n    \"projectId\": \"{{project_id}}\",\n    \"name\": \"Test Table\",\n    \"isSubTable\": false\n}"
      },
      "url": {
        "raw": "{{base_url}}/v1/tables",
        "host": ["{{base_url}}"],
        "path": ["v1", "tables"]
      }
    },
    "response": []
  },
