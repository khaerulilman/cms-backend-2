[
  {
    "name": "Register - Success",
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "exec": [
            "// Generate unique email (timestamp + random)",
            "const timestamp = Date.now();",
            "const randomNum = Math.floor(Math.random() * 10000);",
            "",
            "const randomEmail = `user${timestamp}${randomNum}@example.com`;",
            "pm.environment.set('random_email', randomEmail);",
            "",
            "// Generate random name",
            "const names = ['John Doe', 'Jane Smith', 'Bob Johnson', 'Alice Williams'];",
            "const randomName = names[Math.floor(Math.random() * names.length)];",
            "",
            "pm.environment.set('random_name', randomName);",
            ""
          ],
          "type": "text/javascript",
          "packages": {},
          "requests": {}
        }
      },
      {
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status code is 200 or 201', function () {",
            "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
            "});",
            "",
            "pm.test('Response time is less than 2000ms', function () {",
            "    pm.expect(pm.response.responseTime).to.be.below(2000);",
            "});",
            "",
            "pm.test('Response is JSON', function () {",
            "    pm.response.to.be.json;",
            "});",
            "",
            "// Extract tokens from Set-Cookie headers (same as Login)",
            "if (pm.response.code === 200 || pm.response.code === 201) {",
            "    const jsonData = pm.response.json();",
            "    ",
            "    // Get all headers and find Set-Cookie headers",
            "    const allHeaders = pm.response.headers.all();",
            "    let accessToken = null;",
            "    let refreshToken = null;",
            "    ",
            "    allHeaders.forEach(header => {",
            "        if (header.key && header.key.toLowerCase() === 'set-cookie') {",
            "            const cookieValue = header.value;",
            "            ",
            "            // Extract accessToken",
            "            if (cookieValue.includes('accessToken=')) {",
            "                const match = cookieValue.match(/accessToken=([^;\\s]+)/);",
            "                if (match && match[1]) {",
            "                    accessToken = match[1];",
            "                }",
            "            }",
            "            ",
            "            // Extract refreshToken",
            "            if (cookieValue.includes('refreshToken=')) {",
            "                const match = cookieValue.match(/refreshToken=([^;\\s]+)/);",
            "                if (match && match[1]) {",
            "                    refreshToken = match[1];",
            "                }",
            "            }",
            "        }",
            "    });",
            "    ",
            "    // Save tokens to environment",
            "    if (accessToken) {",
            "        pm.environment.set('access_token', accessToken);",
            "    }",
            "    ",
            "    if (refreshToken) {",
            "        pm.environment.set('refresh_token', refreshToken);",
            "    }",
            "    ",
            "    // Save user data",
            "    if (jsonData.data && jsonData.data.user) {",
            "        pm.environment.set('user_id', jsonData.data.user.id);",
            "    }",
            "}"
          ],
          "type": "text/javascript",
          "packages": {},
          "requests": {}
        }
      }
    ],
    "request": {
      "method": "POST",
      "header": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ],
      "body": {
        "mode": "raw",
        "raw": "{\n    \"name\": \"{{random_name}}\",\n    \"email\": \"{{random_email}}\",\n    \"password\": \"{{password}}\"\n}"
      },
      "url": {
        "raw": "{{base_url}}/v1/auth/register",
        "host": ["{{base_url}}"],
        "path": ["v1", "auth", "register"]
      }
    },
    "response": []
  },
