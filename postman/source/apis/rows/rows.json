[
  {
    "name": "Create Row - Success",
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "exec": [
            "if (!pm.environment.get('access_token')) {",
            "    throw new Error('access_token is not set. Please run Auth folder first.');",
            "}"
          ],
          "type": "text/javascript",
          "packages": {},
          "requests": {}
        }
      },
      {
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status code is 201', function () {",
            "    pm.expect(pm.response.code).to.equal(201);",
            "});",
            "",
            "pm.test('Response is JSON', function () {",
            "    pm.response.to.be.json;",
            "});",
            "",
            "pm.test('Response has success property set to true', function () {",
            "    const jsonData = pm.response.json();",
            "    pm.expect(jsonData.success).to.equal(true);",
            "});",
            "",
            "pm.test('Response has message', function () {",
            "    const jsonData = pm.response.json();",
            "    pm.expect(jsonData.message).to.equal('Row created successfully');",
            "});",
            "",
            "pm.test('Response data contains row id', function () {",
            "    const jsonData = pm.response.json();",
            "    pm.expect(jsonData.data).to.have.property('id');",
            "    ",
            "    // Save row_id for general use",
            "    pm.environment.set('row_id', jsonData.data.id);",
            "});",
            "",
            "pm.test('Response data contains tableId', function () {",
            "    const jsonData = pm.response.json();",
            "    pm.expect(jsonData.data).to.have.property('tableId');",
            "});"
          ],
          "type": "text/javascript",
          "packages": {},
          "requests": {}
        }
      }
    ],
    "request": {
      "method": "POST",
      "header": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cookie",
          "value": "accessToken={{access_token}}"
        }
      ],
      "body": {
        "mode": "raw",
        "raw": "{\n    \"tableId\": \"{{table_id}}\"\n}"
      },
      "url": {
        "raw": "{{base_url}}/v1/cms-rows",
        "host": ["{{base_url}}"],
        "path": ["v1", "cms-rows"]
      }
    },
    "response": []
  },
