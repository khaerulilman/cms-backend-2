[
  {
    "name": "Create Project - Success",
    "event": [
      {
        "listen": "prerequest",
        "script": {
          "exec": [
            "// Generate unique project name",
            "const timestamp = Date.now();",
            "const projectName = `Test Project ${timestamp}`;",
            "pm.environment.set('project_name', projectName);",
            "",
            "// Verify access_token is available",
            "const accessToken = pm.environment.get('access_token');",
            "",
            "if (!accessToken) {",
            "    console.error('ERROR: access_token not found in environment!');",
            "    console.log('Available environment variables:', Object.keys(pm.environment.toObject()));",
            "} else {",
            "    console.log('Using access_token for project creation:', accessToken.substring(0, 30) + '...');",
            "}"
          ],
          "type": "text/javascript",
          "packages": {},
          "requests": {}
        }
      },
      {
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('Status code is 201', function () {",
            "    pm.expect(pm.response.code).to.equal(201);",
            "});",
            "",
            "pm.test('Response is JSON', function () {",
            "    pm.response.to.be.json;",
            "});",
            "",
            "pm.test('Response has success property', function () {",
            "    const jsonData = pm.response.json();",
            "    pm.expect(jsonData.success).to.equal(true);",
            "});",
            "",
            "pm.test('Response contains project data', function () {",
            "    const jsonData = pm.response.json();",
            "    const project = jsonData.data;",
            "    ",
            "    pm.expect(project).to.have.property('id');",
            "    pm.expect(project).to.have.property('name');",
            "    pm.expect(project).to.have.property('userId');",
            "    pm.expect(project).to.have.property('description');",
            "    pm.expect(project).to.have.property('createdAt');",
            "    pm.expect(project).to.have.property('updatedAt');",
            "});",
            "",
            "pm.test('Project name matches input', function () {",
            "    const jsonData = pm.response.json();",
            "    pm.expect(jsonData.data.name).to.equal(pm.environment.get('project_name'));",
            "});",
            "",
            "// Save first project ID for delete tests",
            "if (pm.response.code === 201) {",
            "    const firstProjectId = pm.response.json().data.id;",
            "    pm.environment.set('project_id_for_delete', firstProjectId);",
            "    ",
            "    // Create second project for table and other tests",
            "    const timestamp = Date.now();",
            "    const secondProjectName = `Persistent Project ${timestamp}`;",
            "    ",
            "    pm.sendRequest({",
            "        url: pm.environment.get('base_url') + '/v1/projects',",
            "        method: 'POST',",
            "        header: {",
            "            'Content-Type': 'application/json',",
            "            'Cookie': 'accessToken=' + pm.environment.get('access_token')",
            "        },",
            "        body: {",
            "            mode: 'raw',",
            "            raw: JSON.stringify({",
            "                name: secondProjectName,",
            "                description: 'Persistent project for table tests'",
            "            })",
            "        }",
            "    }, function (err, response) {",
            "        if (!err && response.code === 201) {",
            "            const secondProjectId = response.json().data.id;",
            "            pm.environment.set('project_id', secondProjectId);",
            "            console.log('✅ Created 2 projects:');",
            "            console.log('   - project_id_for_delete:', firstProjectId);",
            "            console.log('   - project_id (persistent):', secondProjectId);",
            "        }",
            "    });",
            "}"
          ],
          "type": "text/javascript",
          "packages": {},
          "requests": {}
        }
      }
    ],
    "request": {
      "method": "POST",
      "header": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cookie",
          "value": "accessToken={{access_token}}",
          "type": "text"
        }
      ],
      "body": {
        "mode": "raw",
        "raw": "{\n    \"name\": \"{{project_name}}\",\n    \"description\": \"This is a test project for CMS\"\n}"
      },
      "url": {
        "raw": "{{base_url}}/v1/projects",
        "host": ["{{base_url}}"],
        "path": ["v1", "projects"]
      }
    },
    "response": []
  },
