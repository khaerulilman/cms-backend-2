generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String         @unique
  password      String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  projects      Project[]
  apiKeys       ApiKey[]
  refreshTokens RefreshToken[]
}

model ApiKey {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  apiKey    String    @unique @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique @db.VarChar(500)
  expiresAt DateTime
  isRevoked Boolean   @default(false)
  userAgent String?   @db.VarChar(500)
  ipAddress String?   @db.VarChar(50)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Project {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String      @db.Uuid
  name        String      @db.VarChar(150)
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cmsTables   CmsTable[]

  @@index([userId])
}
model CmsTable {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String      @db.Uuid
  name        String      @db.VarChar(100)
  isSubTable  Boolean?    @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns     CmsColumn[]
  rows        CmsRow[]

  @@index([projectId])
}

model CmsColumn {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId   String      @db.Uuid
  name      String      @db.VarChar(100)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  table     CmsTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  cells     CmsCell[]

  @@index([tableId]) 
}

model CmsRow {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId   String      @db.Uuid
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  table     CmsTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  cells     CmsCell[]

  @@index([tableId]) 
}

model CmsCell {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rowId                 String   @db.Uuid
  columnId              String   @db.Uuid
  value                 String?
  imageUrl              String?
  cloudinaryPublicId    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  row       CmsRow    @relation(fields: [rowId], references: [id], onDelete: Cascade)
  column    CmsColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@unique([rowId, columnId], map: "rowId_columnId")
  @@index([rowId])    
  @@index([columnId]) 
}
